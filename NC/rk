clear; clc;

% Parameters
t0 = 0; tf = 4; N = 1000;
h = (tf - t0) / N;
t = t0:h:tf;
y = zeros(1, N+1);
y(1) = 0.5; % Initial condition

% Define the ODE as a function handle (still required for evaluation)
f = @(t, y) y - t^2 + 1;

% RK4 loop
for i = 1:N
    k1 = h * f(t(i), y(i));
    k2 = h * f(t(i) + h/2, y(i) + k1/2);
    k3 = h * f(t(i) + h/2, y(i) + k2/2);
    k4 = h * f(t(i) + h, y(i) + k3);
    
    y(i+1) = y(i) + (k1 + 2*k2 + 2*k3 + k4) / 6;
end

% Plot result
plot(t, y, 'b-o');
xlabel('t'); ylabel('y(t)');
title('Rk4 Method Without Separate Function');
grid on;   
